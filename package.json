{
  "name": "bireader",
  "version": "5.0.1",
  "description": "Read and write binary data in JavaScript",
  "type": "module",
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/indexImport.js",
  "browser": "./dist/esm/indexBrowser.js",
  "types": "./dist/cjs/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hearhellacopters/bireader.git"
  },
  "exports": {
    ".": {
      "types": "./dist/cjs/index.d.ts",
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.cjs"
      },
      "import": {
        "types": "./dist/esm/indexImport.d.ts",
        "default": "./dist/esm/indexImport.js"
      },
      "browser": {
        "types": "./dist/esm/indexBrowser.d.ts",
        "default": "./dist/esm/indexBrowser.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npm run clean && rollup -c",
    "build:rollup": "npm run build",
    "clean": "rimraf dist",
    "clean:test": "rimraf dist-test",
    "typecheck": "tsc -p tsconfig.esm.json --noEmit",
    "test": "mocha --require ts-node/register test/**/*.test.ts ",
    "test:engine": "npm run clean:test && tsc -p tsconfig.test.json && mocha --require ts-node/register test/*.engine.spec.ts",
    "apply:aliases": "node scripts/apply-aliases.mjs",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "buffer",
    "parser",
    "reader",
    "binary",
    "decode",
    "unpack",
    "struct",
    "bit",
    "hex"
  ],
  "author": "HearHellacopters",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/hearhellacopters/bireader/issues"
  },
  "homepage": "https://github.com/hearhellacopters/bireader#readme",
  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.3",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-replace": "^6.0.2",
    "@rollup/plugin-typescript": "^12.1.2",
    "@types/chai": "^5.2.3",
    "@types/chai-as-promised": "^8.0.2",
    "@types/mocha": "^10.0.2",
    "@types/node": "^24.12.2",
    "@typescript/lib-dom": "npm:@types/web@^0.0.115",
    "chai": "^6.2.2",
    "chai-as-promised": "^8.0.2",
    "mocha": "^11.7.5",
    "rimraf": "^6.1.3",
    "rollup-plugin-dts": "^6.2.1",
    "rollup-plugin-polyfill-node": "^0.13.0",
    "ts-node": "^10.9.2",
    "tslib": "^2.8.1",
    "typescript": "^5.2.2"
  },
  "overrides": {
    "serialize-javascript": "^7.0.3",
    "diff": "^8.0.3"
  }
}
